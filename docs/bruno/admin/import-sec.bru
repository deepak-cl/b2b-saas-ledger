meta {
  name: Import SEC facts
  type: http
  seq: 7
}

post {
  url: {{gateway}}/api/v1/admin/ingestion/sec
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "tenant": "acme",
    "cik": "320193",
    "years": 5
  }
}

docs {
  operationId: ingestSecCompanyFacts.
  Fetches Apple's company facts (CIK 320193) from SEC EDGAR into the named tenant.
  The ledger process must have SEC_USER_AGENT set, for example "Ledger Local you@example.com".
  The same year window replays. Widening the window later can return 409 IDEMPOTENCY_KEY_REUSED.
}
