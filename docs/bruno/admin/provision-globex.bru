meta {
  name: Provision Globex
  type: http
  seq: 3
}

post {
  url: {{gateway}}/api/v1/admin/tenants
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "slug": "globex",
    "displayName": "Globex",
    "tier": "SHARED",
    "baseCurrency": "USD",
    "seedChartOfAccounts": true
  }
}

docs {
  operationId: provisionTenant.
  Bob is the owner. Alice is a viewer. 409 TENANT_EXISTS means Globex is already there.
}
