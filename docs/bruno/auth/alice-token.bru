meta {
  name: Alice token
  type: http
  seq: 1
}

post {
  url: {{keycloak}}/realms/ledger/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

headers {
  Content-Type: application/x-www-form-urlencoded
}

body:form-urlencoded {
  grant_type: password
  client_id: ledger-web
  username: alice
  password: alice
}

script:post-response {
  const body = res.getBody();
  if (body && body.access_token) {
    bru.setEnvVar("token", body.access_token);
  }
}

docs {
  Password grant for the public client `ledger-web`. Stores the access token in `token`.
  Alice is an accountant of `acme` and a viewer of `globex`. Password equals the username.
}
